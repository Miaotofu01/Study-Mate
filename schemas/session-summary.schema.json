{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionSummary",
  "description": "【已退役 · #71】sessions/ 不再产生新文件，开场也不再读会话记录（目标态规格 §5.1／§5.5）。这份 schema 保留是为了让盘上已有的旧会话摘要仍读得进、仍能被校验器解释（旧技能正文还引它，技能清洗归 #80/#81）；不要照它写新文件。",
  "type": "object",
  "required": ["date", "subject", "session_goal", "learned", "next_step", "weaknesses"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "subject": { "type": "string" },
    "session_goal": { "type": "string" },
    "learned": { "type": "array", "items": { "type": "string" } },
    "next_step": { "type": "string" },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "memory_updates": { "type": "array", "items": { "type": "string" } }
  }
}
