{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "course-manifest",
  "type": "object",
  "required": [
    "course_mode",
    "units"
  ],
  "properties": {
    "course_mode": {
      "enum": [
        "existing",
        "generated"
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "title",
          "objective"
        ],
        "properties": {
          "source_refs": {
            "type": "array"
          },
          "assignments": {
            "type": "array"
          }
        }
      }
    }
  }
}
