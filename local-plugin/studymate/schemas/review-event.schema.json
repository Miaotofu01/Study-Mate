{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review-event",
  "type": "object",
  "required": [
    "event_id",
    "review_item_id",
    "item_version",
    "question_id",
    "question_version",
    "round_id",
    "reviewed_at",
    "rating",
    "independent_attempt"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "independent_attempt": {
      "type": "boolean"
    },
    "help": {
      "type": "object"
    }
  }
}
