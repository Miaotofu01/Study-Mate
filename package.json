{
  "name": "@yunmiao/studymate",
  "version": "1.0.0",
  "description": "StudyMate learning skills and lesson engine for DeepSeek Harness, Google Antigravity, Codex and ChatGPT Work.",
  "type": "module",
  "bin": {
    "studymate": "bin/studymate.mjs"
  },
  "exports": {
    ".": "./bin/dsh-plugin.ts",
    "./qa-preset": "./lib/tools/qa-preset.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**",
    "bin/*.mjs",
    "bin/*.ts",
    "openai/studymate/.codex-plugin/plugin.json",
    "openai/studymate/scripts/*.mjs",
    "openai/studymate/skills/learning-system/references/*.md",
    "antigravity/studymate/**",
    "preset/skills/**",
    "preset/learning/**",
    "preset/qa/**",
    "schemas/*.json",
    "templates/**",
    "docs/**/*.md",
    "docs/images/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:plugin": "node bin/studymate.mjs build-plugin",
    "build:antigravity": "node bin/studymate.mjs build-antigravity",
    "test": "npm run test:types && npm run test:installer && npm run test:openai && npm run test:antigravity && node scripts/release/checks.mjs && npm run test:static",
    "test:types": "node scripts/release/typecheck.mjs",
    "test:openai": "node --test scripts/tests/test_openai_plugin.mjs",
    "test:antigravity": "node --test scripts/tests/test_antigravity_plugin.mjs",
    "test:installer": "node --test scripts/tests/test_installer.mjs scripts/tests/test_bundle.mjs",
    "test:static": "node scripts/release/checks.mjs --static",
    "test:browser": "node scripts/release/checks.mjs --browser",
    "guard:export": "node scripts/release/export_guard.mjs",
    "test:release": "node --test scripts/release/release.test.mjs",
    "test:dsh": "node --test scripts/tests/test_dsh_runtime.mjs",
    "test:dsh-contract": "node --test scripts/tests/test_dsh_contract.mjs",
    "test:dsh-cli": "node --test scripts/tests/test_dsh_plugin_cli.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Cattofu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miaotofu01/Study-Mate.git"
  },
  "homepage": "https://github.com/Miaotofu01/Study-Mate#readme",
  "bugs": {
    "url": "https://github.com/Miaotofu01/Study-Mate/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "studymate",
    "learning",
    "education",
    "antigravity",
    "codex",
    "chatgpt"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
