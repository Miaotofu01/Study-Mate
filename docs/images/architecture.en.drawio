<mxfile host="app.diagrams.net"><diagram id="studymate-arch" name="StudyMate architecture"><mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1290" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="StudyMate — System Architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="700" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="AI study-partner plugin for DeepSeek Harness (DSH) · also packaged for Antigravity, Codex &amp;amp; ChatGPT Work" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="700" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="Agent plane (prompts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="930" y="30" width="125" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="Host half · Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1065" y="30" width="125" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="Client half · Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1200" y="30" width="125" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Data written by agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;ve