nt="1"><mxGeometry x="294" y="942" width="690" height="88" as="geometry"/></mxCell><mxCell id="wReader" value="&lt;b&gt;Written by the reader&lt;/b&gt;&lt;br&gt;&lt;br&gt;reference/: student-added material&lt;br&gt;attempts/: quiz answers (never written back to quizzes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="996" y="942" width="330" height="88" as="geometry"/></mxCell><mxCell id="export" value="&lt;b&gt;export/&lt;/b&gt;&lt;br&gt;&lt;br&gt;self-contained offline site&lt;br&gt;(npx @yunmiao/studymate export)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1360" y="920" width="220" height="112" as="geometry"/></mxCell><mxCell id="dist" value="&lt;b&gt;Install &amp;amp; distribution&lt;/b&gt; — one source tree, three targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1000" height="150" as="geometry"/></mxCell><mxCell id="inst" value="&lt;b&gt;npx @yunmiao/studymate install&lt;/b&gt;&lt;br&gt;registers both presets in DSH&lt;br&gt;writes the workspace config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1135" width="300" height="100" as="geometry"/></mxCell><mxCell id="bopenai" value="&lt;b&gt;npm run build:plugin&lt;/b&gt;&lt;br&gt;same skills → studymate-openai.zip&lt;br&gt;(Codex / ChatGPT Work)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="1135" width="300" height="100" as="geometry"/></mxCell><mxCell id="bag" value="&lt;b&gt;npm run build:antigravity&lt;/b&gt;&lt;br&gt;same skills → Antigravity&lt;br&gt;multi-agent plugin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="1135" width="320" height="100" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;A typical study loop&lt;/b&gt;&lt;br&gt;① Student chats in Learning Mode (“I want to learn C++”)&lt;br&gt;② Orchestrator dispatches roles to build syllabus &amp;amp; lessons&lt;br&gt;③ Native tools validate content &amp;amp; return structured issues&lt;br&gt;④ Validated content is written to the workspace&lt;br&gt;⑤ Watcher pushes changes; reader refreshes live&lt;br&gt;⑥ Student reads and answers; answers are saved to attempts/,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;questions go to a separate Q&amp;amp;A session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;arcSize=8;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1100" width="520" height="150" as="geometry"/></mxCell><mxCell id="e1" value="① chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="student" target="dshchat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="798" y="170"/><mxPoint x="290" y="170"/></Array></mxGeometry></mxCell><mxCell id="e2" value="⑥ read · answer · ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1