ader" value="&lt;b&gt;DeepSeek Harness — Reader view&lt;/b&gt;&lt;br&gt;sidebar switch · renders in the host&#x27;s main slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="215" width="440" height="70" as="geometry"/></mxCell><mxCell id="plugin" value="&lt;b&gt;@yunmiao/studymate&lt;/b&gt; — one DSH plugin package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=14;align=center;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1560" height="530" as="geometry"/></mxCell><mxCell id="colA" value="&lt;b&gt;Agent plane — presets &amp;amp; skills&lt;/b&gt; (preset/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;fontSize=12;align=right;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="460" height="455" as="geometry"/></mxCell><mxCell id="pLearn" value="&lt;b&gt;Learning Mode preset&lt;/b&gt;&lt;br&gt;learning conversation · full toolset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="200" height="56" as="geometry"/></mxCell><mxCell id="pQA" value="&lt;b&gt;Q&amp;amp;A Mode preset&lt;/b&gt;&lt;br&gt;Q&amp;amp;A sessions · read-only lessons&lt;br&gt;no roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="200" height="56" as="geometry"/></mxCell><mxCell id="coach" value="&lt;b&gt;learning-system — Orchestrator&lt;/b&gt;&lt;br&gt;single entry point of the learning conversation:&lt;br&gt;intake · in-place Q&amp;amp;A · records · dispatches roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#5d3f73;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="420" height="70" as="geometry"/></mxCell><mxCell id="roles" value="&lt;b&gt;5 roles&lt;/b&gt; — sub-agents · one writer per subject at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="420" height="150" as="geometry"/></mxCell><mxCell id="r1_0" value="&lt;b&gt;resource-scout&lt;/b&gt;&lt;br&gt;collects resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="92" y="622" width="130" height="48" as="geometry"/></mxCell><mxCell id="r1_1" value="&lt;b&gt;image-scout&lt;/b&gt;&lt;br&gt;collects images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="228" y="622" width="130" height="48" as="geometry"/></mxCell><mxCell id="r1_2" value="&lt;b&gt;curriculum-designer&lt;/b&gt;&lt;br&gt;designs the syllabus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="364" y="622" width="130" height="48" as="geometry"/></mxCell><mxCell id="r2_0" value="&lt;b&gt;learning-coach&lt;/b&gt;&lt;br&gt;writes lessons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="680" width="130" height="48" as="geometry"/></mxCell><mxCell id="r2_1" value="&lt;b&gt;practice-evaluator&lt;/b&gt;&lt;br&gt;questions &amp;amp; grading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="296" y="680" width="130" height="48" as="geometry"/></mxCell><mxCell id="protocols" value="&lt;b&gt;6 protocols&lt;/b&gt; — working rules loaded on demand&lt;br&gt;finding a direction, lesson writing, practice, lab acceptance, Q&amp;amp;A, records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="755" width="420" height="55" as="geometry"/></mxCell><mxCell id="colB" value="&lt;b&gt;Host half — Node&lt;/b&gt; (bin/dsh-plugin.ts + lib/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="560" y="375" width="500" height="455" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Native tools&lt;/b&gt; (studymate_*)&lt;br&gt;validate lessons, syllabus &amp;amp; quizzes · export · check source links&lt;br&gt;background tasks · run lab commands&lt;br&gt;structured results, not exit codes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="460" height="130" as="geometry"/></mxCell><mxCell id="dom0" value="&lt;b&gt;tasks/&lt;/b&gt;&lt;br&gt;background jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="555" width="146" height="42" as="geometry"/></mxCell><mxCell id="dom1" value="&lt;b&gt;watch/&lt;/b&gt;&lt;br&gt;workspace file watcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="737" y="555" width="146" height="42" as="geometry"/></mxCell><mxCell id="dom2" value="&lt;b&gt;lab/&lt;/b&gt;&lt;br&gt;runs lab commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="894" y="555" width="146" height="42" as="geometry"/></mxCell><mxCell id="dom3" value="&lt;b&gt;export/&lt;/b&gt;&lt;br&gt;static-site export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="607" width="146" height="42" as="geometry"/></mxCell><mxCell id="dom4" value="&lt;b&gt;reach/&lt;/b&gt;&lt;br&gt;checks source links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="737" y="607" width="146" height="42" as="geometry"/></mxCell><mxCell id="dom5" value="&lt;b&gt;ask/&lt;/b&gt;&lt;br&gt;opens Q&amp;amp;A Mode sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="894" y="607" width="146" height="42" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;core/ + host/&lt;/b&gt; — pure functions: lesson format, quiz anchors, schema validation&lt;br&gt;domain guard: writes outside the boundary throw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="664" width="460" height="46" as="geometry"/></mxCell><mxCell id="routes" value="&lt;b&gt;Reader data routes&lt;/b&gt; /api/studymate/* (auth by DSH)&lt;br&gt;read study data · write answers &amp;amp; references&lt;br&gt;open Q&amp;amp;A sessions · push changes (SSE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="725" width="460" height="85" as="geometry"/></mxCell><mxCell id="colC" value="&lt;b&gt;Client half — Reader&lt;/b&gt; (lib/client.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f9f1;strokeColor=#82b366;fontSize=12;align=right;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1100" y="375" width="470" height="455" as="geometry"/></mxCell><mxCell id="home" value="&lt;b&gt;Home&lt;/b&gt; — “continue where you left off” + subject list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="410" width="430" height="40" as="geometry"/></mxCell><mxCell id="subj" value="&lt;b&gt;Subject page&lt;/b&gt; — dependency roadmap · add your own references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="460" width="430" height="40" as="geometry"/></mxCell><mxCell id="reader" value="&lt;b&gt;Lesson reader&lt;/b&gt; — 3 columns (side panels collapsed by default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;fontColor=#000000;arcSize=8;container=0;spacingTop=4;spacingLeft=10;spacingRight=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1120" y="510" width="430" height="160" as="geometry"/></mxCell><mxCell id="lc0" value="&lt;b&gt;Left: navigate&lt;/b&gt;&lt;br&gt;&lt;br&gt;node tree&lt;br&gt;glossary · resources&lt;br&gt;learning records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1132" y="540" width="128" height="120" as="geometry"/></mxCell><mxCell id="lc1" value="&lt;b&gt;Centre: lesson&lt;/b&gt;&lt;br&gt;&lt;br&gt;text · images&lt;br&gt;formulas&lt;br&gt;quiz markers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1271" y="540" width="128" height="120" as="geometry"/></mxCell><mxCell id="lc2" value="&lt;b&gt;Right: inspector&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quiz tab: answer&lt;br&gt;Ask tab: ask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1410" y="540" width="128" height="120" as="geometry"/></mxCell><mxCell id="search" value="&lt;b&gt;Search&lt;/b&gt; — across all subjects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="680" width="430" height="35" as="geometry"/></mxCell><mxCell id="datalayer" value="&lt;b&gt;Reader data layer&lt;/b&gt;&lt;br&gt;fetches via /api/studymate/* · live refresh via SSE&lt;br&gt;writes &lt;u&gt;only&lt;/u&gt