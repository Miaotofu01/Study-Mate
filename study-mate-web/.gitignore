# StudyMate Web 运行时产物（勿提交）
data/
# 旧布局残留（含嵌套副本）兜底：运行时数据已上提一级
backend/data/
backend/.venv/
frontend/.next/
# E2E / 探索测试的独立构建目录（见 frontend/next.config.js 的 STUDYMATE_NEXT_DIST）
frontend/.next-e2e/
frontend/.next*/
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
# E2E 手动跑批的控制台日志（结果本体在 test-results/）
frontend/e2e-run*.log
.playwright-cli/
# 探索 agent：API Key 与运行产物（见 frontend/tests/explorer/README.md）
frontend/tests/explorer/.env
frontend/tests/explorer/runs/
frontend/tsconfig.tsbuildinfo
frontend/tests/explorer/env-dump.json
# 归档的低参考价值文档
docs/archive/*.md
