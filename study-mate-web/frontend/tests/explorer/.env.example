# 复制本文件为 .env 并填入真实值（.env 与 runs/ 已被 gitignore，不会提交）
# BASE_URL 必须含到 /v1 为止——实测 https://api.stepfun.com/step_plan/v1 可用，
# 直连 api.stepfun.com/v1 会 402（额度挂在 step_plan 计划通道上）。
EXPLORER_LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
EXPLORER_LLM_API_KEY=
EXPLORER_LLM_MODEL=step-5-preview
# 更快更省的备选：step-3.7-flash（上下文与智能程度低于 5-preview，两者都支持视觉）
